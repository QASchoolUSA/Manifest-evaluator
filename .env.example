# Turso / libSQL (required on Vercel so lots persist across serverless invocations)
# Create a free DB at https://turso.tech then paste:
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Optional aliases
# LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=

# Local/dev without Turso: leave TURSO_* unset — app uses file:./data/manifest-evaluator.db

# Optional: eBay Finding API App ID for sold comps
EBAY_APP_ID=
