# Turso / libSQL (required on Vercel so lots persist across serverless invocations)
# Create a free DB at https://turso.tech then paste:
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Optional aliases
# LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=

# Local/dev without Turso: leave TURSO_* unset — app uses file:./data/manifest-evaluator.db

# eBay Finding API App ID (App ID / Client ID from developer.ebay.com)
# Used first for sold comps. Free-tier rate limits auto-fall back to
# eBay HTML → RockAuto → Amazon → retail heuristic for ~10 minutes.
EBAY_APP_ID=

# REQUIRED for real Advance Auto /p/ product pages (https://serper.dev — free tier)
# Advance blocks serverless IPs on their catalog API. Serper finds the indexed
# product URL via Google. Without this key, Advance clicks fall back to Google site-search.
SERPER_API_KEY=
